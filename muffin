#!/usr/bin/env bash

# Muffin - Portable Web App Runner & Installer

# Ensure background GUI executions have a complete PATH
export PATH="$HOME/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# Function to display errors and exit
die() {
    echo "Error: $1" >&2
    exit 1
}

install_dependencies() {
    if command -v dnf >/dev/null 2>&1; then
        echo "Detected dnf (Fedora/RHEL). Installing dependencies..."
        sudo dnf install -y python3-gobject webkit2gtk4.1 unzip
    elif command -v apt-get >/dev/null 2>&1; then
        echo "Detected apt (Debian/Ubuntu). Installing dependencies..."
        sudo apt-get update
        sudo apt-get install -y python3-gi gir1.2-webkit2-4.1 unzip || sudo apt-get install -y python3-gi gir1.2-webkit2-4.0 unzip
    elif command -v pacman >/dev/null 2>&1; then
        echo "Detected pacman (Arch Linux). Installing dependencies..."
        sudo pacman -S --needed --noconfirm python-gobject webkit2gtk-4.1 unzip
    elif command -v zypper >/dev/null 2>&1; then
        echo "Detected zypper (openSUSE). Installing dependencies..."
        sudo zypper install -y python3-gobject typelib-1_0-WebKit2-4_1 unzip
    else
        die "Could not detect your package manager. Please manually install unzip, Python3 GObject, and WebKit2GTK."
    fi
}

ensure_mime_association() {
    local muffin_self
    muffin_self=$(readlink -f "$0")
    local muffin_self_dir
    muffin_self_dir=$(dirname "$muffin_self")

    local mime_package_file="$HOME/.local/share/mime/packages/muffin.xml"
    local muffin_desktop="$HOME/.local/share/applications/muffin.desktop"
    local mime_icon="$HOME/.local/share/icons/application-x-muffin-portable-archive.png"

    if [ ! -f "$mime_package_file" ] || [ ! -f "$muffin_desktop" ] || ! grep -q "Exec=\"$muffin_self\"" "$muffin_desktop" 2>/dev/null; then
        echo "Configuring .mpa system file associations..."

        mkdir -p "$HOME/.local/share/mime/packages"
        cat <<EOF > "$mime_package_file"
<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-muffin-portable-archive">
    <comment>Muffin Portable Archive</comment>
    <glob pattern="*.mpa"/>
    <icon name="application-x-muffin-portable-archive"/>
  </mime-type>
</mime-info>
EOF

        mkdir -p "$HOME/.local/share/icons"
        if [ -f "$muffin_self_dir/icon.png" ]; then
            cp "$muffin_self_dir/icon.png" "$mime_icon"
            mkdir -p "$HOME/.local/share/icons/hicolor/48x48/mimetypes"
            cp "$muffin_self_dir/icon.png" "$HOME/.local/share/icons/hicolor/48x48/mimetypes/application-x-muffin-portable-archive.png"
            mkdir -p "$HOME/.local/share/icons/hicolor/256x256/mimetypes"
            cp "$muffin_self_dir/icon.png" "$HOME/.local/share/icons/hicolor/256x256/mimetypes/application-x-muffin-portable-archive.png"
        fi

        mkdir -p "$HOME/.local/share/applications"
        cat <<EOF > "$muffin_desktop"
[Desktop Entry]
Type=Application
Name=Muffin Runner
Exec="$muffin_self" run %f
Icon=application-x-muffin-portable-archive
Terminal=false
NoDisplay=true
MimeType=application/x-muffin-portable-archive;
EOF
        chmod +x "$muffin_desktop"

        if command -v update-mime-database >/dev/null 2>&1; then update-mime-database "$HOME/.local/share/mime"; fi
        if command -v xdg-mime >/dev/null 2>&1; then xdg-mime default muffin.desktop application/x-muffin-portable-archive; fi
        if command -v update-desktop-database >/dev/null 2>&1; then update-desktop-database "$HOME/.local/share/applications"; fi
    fi
}

check_dependencies() {
    local missing=0

    if ! command -v unzip >/dev/null 2>&1; then missing=1; fi
    if ! command -v python3 >/dev/null 2>&1; then missing=1; fi
    
    if [ $missing -eq 0 ]; then
        if ! python3 -c "import gi" 2>/dev/null; then missing=1
        elif ! (python3 -c "import gi; gi.require_version('WebKit2', '4.1')" 2>/dev/null || python3 -c "import gi; gi.require_version('WebKit2', '4.0')" 2>/dev/null); then
            missing=1
        fi
    fi

    if [ $missing -eq 1 ]; then
        # Prevent background GUI launches from silently hanging on a 'sudo' terminal prompt
        if [ ! -t 1 ]; then
            command -v zenity >/dev/null 2>&1 && zenity --error --text="Muffin is missing system dependencies.\nPlease run 'muffin' directly in your terminal to install them."
            die "Missing dependencies. Run in terminal to auto-install."
        else
            echo "Missing required system dependencies. Attempting auto-install..."
            install_dependencies
        fi
        
        if ! command -v unzip >/dev/null 2>&1 || ! python3 -c "import gi" 2>/dev/null; then
            die "Auto-install failed. Please install dependencies manually."
        fi
    fi

    ensure_mime_association
}

# Verify arguments
if { [ "$1" != "run" ] && [ "$1" != "delete" ]; } || [ -z "$2" ]; then
    echo "Muffin Portable Archive Launcher & Manager"
    echo "Usage:"
    echo "  muffin run <path/to/app.mpa_or_app_name>"
    echo "  muffin delete <path/to/app.mpa_or_app_name>"
    exit 1
fi

COMMAND="$1"
INPUT_ARG="$2"
MUFFIN_LIB="$HOME/.local/share/muffin/library"
APP_NAME=$(basename "$INPUT_ARG" .mpa)

# --- DELETE COMMAND LOGIC ---
if [ "$COMMAND" = "delete" ]; then
    echo "Uninstalling Muffin App: $APP_NAME"
    
    DESKTOP_FILE="$HOME/.local/share/applications/muffin-$APP_NAME.desktop"
    APP_DIR="$HOME/.local/share/muffin/apps/$APP_NAME"
    DATA_DIR="$HOME/.local/share/muffin/data/$APP_NAME"
    CACHE_DIR="$HOME/.cache/muffin/$APP_NAME"
    LIBRARY_MPA="$MUFFIN_LIB/${APP_NAME}.mpa"
    
    deleted_any=false

    if [ -f "$DESKTOP_FILE" ]; then rm -f "$DESKTOP_FILE"; deleted_any=true; fi
    for ext in png svg ico jpeg gif; do
        if [ -f "$HOME/.local/share/icons/muffin-$APP_NAME.$ext" ]; then
            rm -f "$HOME/.local/share/icons/muffin-$APP_NAME.$ext"
            deleted_any=true
        fi
    done
    if [ -d "$APP_DIR" ]; then rm -rf "$APP_DIR"; deleted_any=true; fi
    if [ -d "$DATA_DIR" ]; then rm -rf "$DATA_DIR"; echo "  - Cleaned persistent session data."; deleted_any=true; fi
    if [ -d "$CACHE_DIR" ]; then rm -rf "$CACHE_DIR"; deleted_any=true; fi
    if [ -f "$LIBRARY_MPA" ]; then rm -f "$LIBRARY_MPA"; deleted_any=true; fi

    if [ "$deleted_any" = true ]; then
        if command -v update-desktop-database >/dev/null 2>&1; then update-desktop-database "$HOME/.local/share/applications"; fi
        echo "Successfully deleted '$APP_NAME'."
    else
        echo "No installed components found for app '$APP_NAME'."
    fi
    exit 0
fi

# --- RUN COMMAND LOGIC ---
check_dependencies

MPA_FILE=""
if [ -f "$INPUT_ARG" ]; then MPA_FILE="$INPUT_ARG"
elif [ -f "$MUFFIN_LIB/$INPUT_ARG" ]; then MPA_FILE="$MUFFIN_LIB/$INPUT_ARG"
elif [ -f "$MUFFIN_LIB/${INPUT_ARG}.mpa" ]; then MPA_FILE="$MUFFIN_LIB/${INPUT_ARG}.mpa"
else die "Could not find application '$INPUT_ARG' locally or in your library ($MUFFIN_LIB)."; fi

if [[ "$MPA_FILE" != /* ]]; then MPA_FILE="$(pwd)/$MPA_FILE"; fi

MUFFIN_DIR="$HOME/.local/share/muffin"
APP_DIR="$MUFFIN_DIR/apps/$APP_NAME"
PYTHON_RUNNER="$MUFFIN_DIR/runner.py"

mkdir -p "$APP_DIR" "$HOME/.local/share/icons" "$HOME/.local/share/applications"

echo "Loading $APP_NAME..."
rm -rf "$APP_DIR"/*
unzip -q -o "$MPA_FILE" -d "$APP_DIR" || die "Failed to extract $MPA_FILE. Is it a valid zip archive?"

# Route Target URL (Live App vs Local App)
TARGET_URL=""
if [ -f "$APP_DIR/live.txt" ]; then
    TARGET_URL=$(cat "$APP_DIR/live.txt" | tr -d '\r\n')
    echo "Live App Detected: Routing to $TARGET_URL"
else
    INDEX_PATH=$(find "$APP_DIR" -maxdepth 3 -name "index.html" | head -n 1)
    if [ -n "$INDEX_PATH" ]; then
        INDEX_DIR=$(dirname "$INDEX_PATH")
        if [ "$INDEX_DIR" != "$APP_DIR" ]; then
            shopt -s dotglob; mv "$INDEX_DIR"/* "$APP_DIR/" 2>/dev/null; shopt -u dotglob
            find "$APP_DIR" -mindepth 1 -type d -empty -delete
        fi
        TARGET_URL="file://$APP_DIR/index.html"
    else
        die "Invalid App: Missing live.txt or index.html."
    fi
fi

ICON_PATH=""
if [ -f "$APP_DIR/icon.png" ]; then ICON_PATH="$APP_DIR/icon.png"
else
    FAVICON_PATH=$(find "$APP_DIR" -maxdepth 2 -iname "favicon.*" | head -n 1)
    if [ -n "$FAVICON_PATH" ]; then ICON_PATH="$FAVICON_PATH"; fi
fi

DESKTOP_FILE="$HOME/.local/share/applications/muffin-$APP_NAME.desktop"
if [ ! -f "$DESKTOP_FILE" ]; then
    if [ -n "$ICON_PATH" ]; then
        ICON_EXT="${ICON_PATH##*.}"
        SYSTEM_ICON_DEST="$HOME/.local/share/icons/muffin-$APP_NAME.$ICON_EXT"
        cp "$ICON_PATH" "$SYSTEM_ICON_DEST"
        ICON_LINE="Icon=$SYSTEM_ICON_DEST"
    else
        ICON_LINE="Icon=application-x-executable"
    fi
    
    # Guarantee absolute execution path for background menu launches
    MUFFIN_BIN=$(readlink -f "$0")
    
    cat <<EOF > "$DESKTOP_FILE"
[Desktop Entry]
Type=Application
Name=$APP_NAME
Exec="$MUFFIN_BIN" run "$MPA_FILE"
$ICON_LINE
Terminal=false
Categories=Network;Utility;
EOF
    chmod +x "$DESKTOP_FILE"
    if command -v update-desktop-database >/dev/null 2>&1; then update-desktop-database "$HOME/.local/share/applications"; fi
fi

# 3. Create Webview Runner (With Persistent Sessions & Hardware Permissions)
cat << 'EOF' > "$PYTHON_RUNNER"
#!/usr/bin/env python3
import sys
import os

try:
    import gi
    gi.require_version('Gtk', '3.0')
    try: gi.require_version('WebKit2', '4.1')
    except ValueError: gi.require_version('WebKit2', '4.0')
    from gi.repository import Gtk, WebKit2, Gio
except ImportError as e:
    print(f"Error: Missing Python GTK/WebKit2 dependencies. Details: {e}")
    sys.exit(1)

app_title = sys.argv[1]
app_url = sys.argv[2]
app_name_safe = app_title.replace(" ", "_").lower()

def apply_system_theme():
    try:
        settings = Gtk.Settings.get_default()
        if "dark" in Gio.Settings.new("org.gnome.desktop.interface").get_string("color-scheme").lower() or \
           "dark" in settings.get_property("gtk-theme-name").lower():
            settings.set_property("gtk-application-prefer-dark-theme", True)
    except Exception: pass

class MuffinWindow(Gtk.Window):
    def __init__(self):
        Gtk.Window.__init__(self, title=app_title)
        self.set_default_size(1280, 800)
        self.set_position(Gtk.WindowPosition.CENTER)

        # 1. Establish Persistent Session Directories
        data_dir = os.path.expanduser(f"~/.local/share/muffin/data/{app_name_safe}")
        cache_dir = os.path.expanduser(f"~/.cache/muffin/{app_name_safe}")
        os.makedirs(data_dir, exist_ok=True)
        os.makedirs(cache_dir, exist_ok=True)

        data_manager = WebKit2.WebsiteDataManager(
            base_data_directory=data_dir,
            base_cache_directory=cache_dir
        )
        web_context = WebKit2.WebContext(website_data_manager=data_manager)

        # 2. Configure Chrome Spoofing & Engine Settings
        settings = WebKit2.Settings()
        settings.set_user_agent("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36")
        
        props = {
            "enable-javascript": True,
            "enable-webgl": True,
            "enable-developer-extras": True,
            "allow-file-access-from-file-urls": True,
            "allow-universal-access-from-file-urls": True,
            "enable-mediasource": True
        }
        for prop, value in props.items():
            try: settings.set_property(prop, value)
            except Exception: pass

        self.webview = WebKit2.WebView(web_context=web_context, settings=settings)

        # 3. Handle Hardware Permissions (Mic, Camera, Notifications)
        def on_permission_request(view, request):
            request.allow()
            return True
        
        self.webview.connect("permission-request", on_permission_request)

        self.webview.load_uri(app_url)
        self.add(self.webview)
        self.connect("destroy", Gtk.main_quit)
        self.show_all()

if __name__ == "__main__":
    apply_system_theme()
    app = MuffinWindow()
    Gtk.main()
EOF
chmod +x "$PYTHON_RUNNER"

# 4. Launch the application (Now generating a runtime log for background GUI execution debugging)
LOG_FILE="$HOME/.cache/muffin/${APP_NAME}_runtime.log"
echo "Launching $APP_NAME... (Logging to $LOG_FILE)"
exec "$PYTHON_RUNNER" "$APP_NAME" "$TARGET_URL" >> "$LOG_FILE" 2>&1