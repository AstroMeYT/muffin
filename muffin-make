#!/usr/bin/env bash

# Muffin Maker - Package websites or local folders into .mpa files
# Usage: muffin-make <url|folder> <source> [custom-app-name]

die() {
    echo "Error: $1" >&2
    exit 1
}

# Verify arguments
if [ $# -lt 2 ]; then
    echo "Muffin Portable Archive (.mpa) Packager"
    echo "Usage: muffin-make <url|folder> <source> [custom-app-name]"
    echo ""
    echo "Examples:"
    echo "  muffin-make url https://rawg.io rawg-games"
    echo "  muffin-make folder /path/to/my/website local-app"
    exit 1
fi

MODE="$1"
SOURCE="$2"
RAW_NAME="$3"

# 1. Ensure essential tools are present
command -v zip >/dev/null 2>&1 || die "zip is required to package archives. Please install it."

if [ "$MODE" = "url" ]; then
    command -v wget >/dev/null 2>&1 || die "wget is required to download websites. Please install it."
fi

# 2. Parse source and determine app name
if [ "$MODE" = "url" ]; then
    URL="$SOURCE"
    # Clean up URL format if scheme is missing
    if [[ "$URL" != http://* ]] && [[ "$URL" != https://* ]]; then
        URL="https://$URL"
    fi
    # Extract domain for fallback app name
    DOMAIN=$(echo "$URL" | awk -F[/:] '{print $4}')
    [ -z "$DOMAIN" ] && DOMAIN="web_app"
    [ -z "$RAW_NAME" ] && RAW_NAME="$DOMAIN"
    
elif [ "$MODE" = "folder" ]; then
    if [ ! -d "$SOURCE" ]; then
        die "Directory not found: $SOURCE"
    fi
    # Fallback to the name of the folder if no custom name is provided
    [ -z "$RAW_NAME" ] && RAW_NAME=$(basename "$(realpath "$SOURCE")")
else
    die "Invalid mode: $MODE. Must be 'url' or 'folder'."
fi

# Setup Application Name (stripping bad chars)
APP_NAME=$(echo "$RAW_NAME" | sed 's/[^a-zA-Z0-9_-]/_/g' | tr '[:upper:]' '[:lower:]')

# Setup paths
MUFFIN_LIB="$HOME/.local/share/muffin/library"
mkdir -p "$MUFFIN_LIB"

# Temporary directory for building the app assets
BUILD_DIR=$(mktemp -d -t muffin-build-XXXXXX)
# Ensure build folder gets scrubbed when script finishes
cleanup() {
    rm -rf "$BUILD_DIR"
}
trap cleanup EXIT

echo "=========================================="
echo "Creating Muffin App: $APP_NAME"
echo "Mode: $MODE"
echo "Source: $SOURCE"
echo "Build Directory: $BUILD_DIR"
echo "=========================================="

# 3. Gather assets based on mode
if [ "$MODE" = "url" ]; then
    echo "Downloading website assets... (This might take a moment)"
    wget \
        --recursive \
        --level=2 \
        --page-requisites \
        --adjust-extension \
        --convert-links \
        --no-parent \
        --no-host-directories \
        --directory-prefix="$BUILD_DIR" \
        --quiet \
        --show-progress \
        "$URL" || echo "Warning: Download returned non-zero, but attempting to package anyway..."
else
    echo "Copying local directory assets..."
    cp -r "$SOURCE"/* "$BUILD_DIR/" 2>/dev/null || cp -r "$SOURCE/." "$BUILD_DIR/"
fi

# 4. Locate the entry-point index file and normalize it to root index.html
FOUND_ENTRY=$(find "$BUILD_DIR" -type f -name "*.html" | head -n 1)

if [ -z "$FOUND_ENTRY" ]; then
    die "Failed to find any HTML entrypoint in the source."
fi

# If the entrypoint isn't named index.html at root, normalize it
if [ "$FOUND_ENTRY" != "$BUILD_DIR/index.html" ]; then
    echo "Normalizing main HTML file to index.html..."
    mv "$FOUND_ENTRY" "$BUILD_DIR/index.html"
fi

# 5. Handle Favicon Resolution (WITHOUT relying on parsing HTML files)
echo "Searching for favicon in assets..."
# First, look inside the gathered files for any file named favicon.*
LOCAL_FAVICON=$(find "$BUILD_DIR" -maxdepth 3 -iname "favicon.*" | head -n 1)

# If building from URL and no local favicon found, try fetching from root domain
if [ -z "$LOCAL_FAVICON" ] && [ "$MODE" = "url" ]; then
    echo "No favicon discovered in downloaded assets. Fetching from common web root paths..."
    BASE_URL=$(echo "$URL" | grep -oP '^https?://[^/]+')
    
    # Intelligently query common direct extensions
    for ext in ico png svg; do
        echo "Trying $BASE_URL/favicon.$ext..."
        wget -q -O "$BUILD_DIR/favicon.$ext" "$BASE_URL/favicon.$ext"
        if [ -f "$BUILD_DIR/favicon.$ext" ] && [ -s "$BUILD_DIR/favicon.$ext" ]; then
            LOCAL_FAVICON="$BUILD_DIR/favicon.$ext"
            break
        else
            rm -f "$BUILD_DIR/favicon.$ext" # Clean up empty/failed attempts
        fi
    done
fi

if [ -n "$LOCAL_FAVICON" ]; then
    echo "Found favicon: $(basename "$LOCAL_FAVICON")"
    
    # Optional enhancement: Convert high-res ico structure to png if ImageMagick is active
    if [[ "$LOCAL_FAVICON" == *.ico ]] && command -v convert >/dev/null 2>&1; then
        echo "Converting .ico structure to icon.png for optimal system render compatibility..."
        convert "$LOCAL_FAVICON[0]" "$BUILD_DIR/icon.png" 2>/dev/null
    fi
else
    echo "Could not find any favicon. Muffin will default to its core fallback icon."
fi

# 6. Pack everything up into an .mpa in our shared Library!
echo "Generating .mpa package..."
OUTPUT_FILE="$MUFFIN_LIB/${APP_NAME}.mpa"

# Remove existing version if we are overwriting
rm -f "$OUTPUT_FILE"

# Change directory into the build directory to avoid archiving directory structures
cd "$BUILD_DIR" || die "Failed to enter build directory."
zip -q -r "$OUTPUT_FILE" ./*

echo "=========================================="
echo "SUCCESS: App created!"
echo "Package Saved: $OUTPUT_FILE"
echo "=========================================="
echo "You can now launch your portable app instantly using:"
echo "  muffin run $APP_NAME"
echo "=========================================="