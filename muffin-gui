        action_folder.connect("activate", self.on_make_folder_clicked)
        app.add_action(action_folder)

        action_live = Gio.SimpleAction.new("create_live", None)
        action_live.connect("activate", self.on_make_live_clicked)
        app.add_action(action_live)
        
        action_import = Gio.SimpleAction.new("import_file", None)
        action_import.connect("activate", self.on_import_clicked)
        app.add_action(action_import)
        
        # Reload button
        reload_btn = Gtk.Button(icon_name="view-refresh-symbolic")
        reload_btn.connect("clicked", lambda x: self.reload_all())
        header.pack_end(reload_btn)

        # View Stack (Tabs)
        self.view_stack = Adw.ViewStack()
        main_box.append(self.view_stack)
        
        # View Switcher in Header
        switcher_title = Adw.ViewSwitcherTitle()
        switcher_title.set_stack(self.view_stack)
        header.set_title_widget(switcher_title)

        # ==========================================
        # PAGE 1: LOCAL LIBRARY
        # ==========================================
        library_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        
        lib_scroll = Gtk.ScrolledWindow()
        lib_scroll.set_vexpand(True)
        library_box.append(lib_scroll)
        
        self.lib_content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        self.lib_content.set_margin_top(32)
        self.lib_content.set_margin_bottom(32)
        self.lib_content.set_margin_start(32)
        self.lib_content.set_margin_end(32)
        lib_scroll.set_child(self.lib_content)
        
        self.app_group = Adw.PreferencesGroup(title="Installed Apps")
        self.lib_content.append(self.app_group)
        
        self.status_page = Adw.StatusPage(
            title="No Apps Found",
            description="Create or import a Muffin app to get started.",
            icon_name="application-x-executable-symbolic"
        )
        self.lib_content.append(self.status_page)
        
        lib_page = self.view_stack.add_titled(library_box, "library", "Library")
        lib_page.set_icon_name("folder-symbolic")

        # ==========================================
        # PAGE 2: APP STORE (GITHUB REPO)
        # ==========================================
        store_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        
        self.search_entry = Gtk.SearchEntry(placeholder_text="Search repository for apps...")
        self.search_entry.set_margin_top(12)
        self.search_entry.set_margin_bottom(12)
        self.search_entry.set_margin_start(12)
        self.search_entry.set_margin_end(12)
        self.search_entry.connect("search-changed", self.on_store_search)
        store_box.append(self.search_entry)
        
        store_scroll = Gtk.ScrolledWindow()
        store_scroll.set_vexpand(True)
        store_box.append(store_scroll)
        
        self.store_content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        self.store_content.set_margin_top(12)
        self.store_content.set_margin_bottom(32)
        self.store_content.set_margin_start(32)
        self.store_content.set_margin_end(32)
        store_scroll.set_child(self.store_content)
        
        self.store_group = Adw.PreferencesGroup(title="Available Packages")
        self.store_content.append(self.store_group)
        
        self.store_spinner = Gtk.Spinner()
        self.store_spinner.set_halign(Gtk.Align.CENTER)
        self.store_spinner.set_margin_top(32)
        self.store_content.append(self.store_spinner)
        
        self.store_status = Adw.StatusPage(
            title="Loading Store...", 
            icon_name="network-server-symbolic"
        )
        self.store_content.append(self.store_status)
        
        store_page = self.view_stack.add_titled(store_box, "store", "Store")
        store_page.set_icon_name("applications-system-symbolic")

        # Initialization
        self.app_rows = []
        self.store_rows = []
        self.all_store_packages = []
        self.store_search_query = ""
        
        self.reload_all()

    def reload_all(self):
        self.load_library()
        self.load_store()
        
    def get_script_path(self, script_name):
        if shutil.which(script_name): return script_name
        script_dir = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
        local_path = os.path.join(script_dir, script_name)
        if os.path.exists(local_path): return local_path
        local_bin = os.path.expanduser(f"~/.local/bin/{script_name}")
        if os.path.exists(local_bin): return local_bin
        return script_name 

    # ==========================================
    # LOCAL LIBRARY LOGIC
    # ==========================================
    def load_library(self):
        for row in self.app_rows:
            self.app_group.remove(row)
        self.app_rows.clear()
            
        apps = []
        if os.path.exists(self.library_path):
            for f in os.listdir(self.library_path):
                if f.endswith(".mpa"):
                    apps.append(f)
                    
        if not apps:
            self.app_group.set_visible(False)
            self.status_page.set_visible(True)
        else:
            self.app_group.set_visible(True)
            self.status_page.set_visible(False)
            
            for app_file in sorted(apps):
                app_name = app_file[:-4] # Remove .mpa
                
                row = Adw.ActionRow(title=app_name, subtitle=f"Library App")
                
                # Run button
                btn_run = Gtk.Button(icon_name="media-playback-start-symbolic")
                btn_run.set_valign(Gtk.Align.CENTER)
                btn_run.add_css_class("suggested-action")
                btn_run.connect("clicked", self.create_run_callback(app_name))
                row.add_suffix(btn_run)
                
                # Delete button
                btn_delete = Gtk.Button(icon_name="user-trash-symbolic")
                btn_delete.set_valign(Gtk.Align.CENTER)
                btn_delete.add_css_class("destructive-action")
                btn_delete.connect("clicked", self.create_delete_callback(app_name))
                row.add_suffix(btn_delete)
                
                self.app_group.add(row)
                self.app_rows.append(row)

        # Re-render store to ensure "Installed" labels are strictly synced with local library
        if self.all_store_packages:
            self.render_store()

    def create_run_callback(self, app_name):
        def callback(btn):
            cmd = [self.get_script_path("muffin"), "run", app_name]
            try:
                subprocess.Popen(cmd)
                self.show_toast(f"Starting {app_name}...")
            except Exception as e:
                self.show_message("Error Starting App", f"Failed to execute command:\n{' '.join(cmd)}\n\nError: {e}")
        return callback
        
    def create_delete_callback(self, app_name):
        def callback(btn):
            dialog = Adw.MessageDialog(heading=f"Delete {app_name}?", transient_for=self)
            dialog.set_body("This will remove the app from your library.")
            dialog.add_response("cancel", "Cancel")
            dialog.add_response("delete", "Delete")
            dialog.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
            
            def handle_response(d, r):
                d.close()
                self.on_delete_confirm(r, app_name)
                
            dialog.connect("response", handle_response)
            dialog.present()
        return callback
        
    def on_delete_confirm(self, response, app_name):
        if response == "delete":
            cmd = [self.get_script_path("muffin"), "delete", app_name]
            self.run_command_async(cmd, f"{app_name} deleted successfully!")

    # ==========================================
    # STORE LOGIC (GITHUB REPO)
    # ==========================================
    def load_store(self):
        self.store_spinner.start()
        self.store_spinner.set_visible(True)
        self.store_group.set_visible(False)
        self.store_status.set_visible(False)
        
        def fetch():
            try:
                url = "https://raw.githubusercontent.com/AstroMeYT/Muffin-repo/refs/heads/main/packages.json"
                req = urllib.request.Request(url, headers={"User-Agent": "Muffin-GUI"})
                with urllib.request.urlopen(req) as response:
                    data = json.loads(response.read().decode())
                
                packages = data.get("packages", [])
                GLib.idle_add(self.on_store_loaded, packages, None)
            except Exception as e:
                GLib.idle_add(self.on_store_loaded, None, str(e))
                
        threading.Thread(target=fetch, daemon=True).start()

    def on_store_loaded(self, packages, error):
        self.store_spinner.stop()
        self.store_spinner.set_visible(False)
        
        if error:
            self.store_status.set_title("Store Offline")
            self.store_status.set_description(f"Failed to fetch remote packages:\n{error}")
            self.store_status.set_visible(True)
            return
            
        if not packages:
            self.store_status.set_title("Store Empty")
            self.store_status.set_description("No packages found in the remote repository.")
            self.store_status.set_visible(True)
            return
            
        self.all_store_packages = packages
        self.render_store()

    def on_store_search(self, entry):
        self.store_search_query = entry.get_text().lower()
        self.render_store()

    def render_store(self):
        for row in self.store_rows:
            self.store_group.remove(row)
        self.store_rows.clear()
        
        self.store_group.set_visible(True)
        self.store_status.set_visible(False)
        
        displayed = 0
        for pkg in sorted(self.all_store_packages, key=lambda x: x["name"]):
            name_lower = pkg["name"].lower()
            if self.store_search_query and self.store_search_query not in name_lower:
                continue
                
            displayed += 1
            size_kb = pkg.get("size_bytes", 0) / 1024
            row = Adw.ActionRow(title=pkg["name"], subtitle=f"Remote Archive  •  {size_kb:.1f} KB")
            
            # Check if this package is already in the local library
            local_file = os.path.join(self.library_path, pkg["filename"])
            if os.path.exists(local_file):
                btn = Gtk.Button(label="Installed", icon_name="object-select-symbolic")
                btn.set_sensitive(False)
                btn.add_css_class("flat")
            else:
                btn = Gtk.Button(label="Install", icon_name="emblem-downloads-symbolic")
                btn.add_css_class("suggested-action")
                btn.connect("clicked", lambda b, p=pkg: self.download_package(p, b))
                
            btn.set_valign(Gtk.Align.CENTER)
            row.add_suffix(btn)
            
            self.store_group.add(row)
            self.store_rows.append(row)
            
        if displayed == 0 and self.store_search_query:
            self.store_group.set_visible(False)
            self.store_status.set_title("No Results")
            self.store_status.set_description(f"No apps match '{self.store_search_query}'.")
            self.store_status.set_visible(True)

    def download_package(self, pkg, btn):
        btn.set_sensitive(False)
        btn.set_label("Downloading...")
        btn.set_icon_name("")
        self.show_toast(f"Downloading {pkg['name']}...")
        
        def run():
            try:
                dest = os.path.join(self.library_path, pkg['filename'])
                req = urllib.request.Request(pkg['download_url'], headers={"User-Agent": "Muffin-GUI"})
                
                with urllib.request.urlopen(req) as response, open(dest, 'wb') as out_file:
                    shutil.copyfileobj(response, out_file)
                    
                GLib.idle_add(self.on_download_success, pkg)
            except Exception as e:
                GLib.idle_add(self.on_download_error, str(e), btn)
                
        threading.Thread(target=run, daemon=True).start()

    def on_download_success(self, pkg):
        self.show_toast(f"Successfully installed {pkg['name']}!")
        # Reload library triggers a store re-render to lock the install buttons automatically
        self.load_library()
        
    def on_download_error(self, error_msg, btn):
        btn.set_label("Install")
        btn.set_icon_name("emblem-downloads-symbolic")
        btn.set_sensitive(True)
        self.show_message("Download Error", f"Failed to download package:\n{error_msg}")

    # ==========================================
    # CREATION & IMPORT ACTIONS
    # ==========================================
    def on_import_clicked(self, action, param):
        dialog = Gtk.FileDialog(title="Import .mpa File to Library")
        f_filter = Gtk.FileFilter()
        f_filter.set_name("Muffin Portable Archives")
        f_filter.add_pattern("*.mpa")
        
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(f_filter)
        dialog.set_filters(filters)
        
        dialog.open(self, None, self.on_import_dialog_open, None)
        
    def on_import_dialog_open(self, dialog, result, data):
        try:
            file = dialog.open_finish(result)
            if file:
                path = file.get_path()
                filename = os.path.basename(path)
                dest = os.path.join(self.library_path, filename)
                try:
                    shutil.copy2(path, dest)
                    self.show_toast(f"Imported {filename} to library!")
                    self.load_library()
                except Exception as e:
                    self.show_message("Error", f"Failed to import: {e}")
        except GLib.Error:
            pass

    def on_make_url_clicked(self, action, param):
        dialog = Adw.MessageDialog(heading="Create from URL", transient_for=self)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("create", "Create")
        dialog.set_response_appearance("create", Adw.ResponseAppearance.SUGGESTED)
        
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        url_entry = Gtk.Entry(placeholder_text="https://example.com")
        name_entry = Gtk.Entry(placeholder_text="App Name (optional)")
        box.append(url_entry)
        box.append(name_entry)
        dialog.set_extra_child(box)
        
        def handle_response(d, r):
            d.close()
            self.on_make_url_response(r, url_entry.get_text(), name_entry.get_text())
            
        dialog.connect("response", handle_response)
        dialog.present()
        
    def on_make_url_response(self, response, url, name):
        if response == "create" and url:
            cmd = [self.get_script_path("muffin-make"), "url", url]
            if name:
                cmd.append(name.replace(" ", "_"))
            self.run_command_async(cmd, "App created successfully!")

    def on_make_live_clicked(self, action, param):
        dialog = Adw.MessageDialog(heading="Create Live App", transient_for=self)
        dialog.set_body("Live apps serve as a fast desktop wrapper for live websites and require a custom desktop icon.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("next", "Select Icon...")
        dialog.set_response_appearance("next", Adw.ResponseAppearance.SUGGESTED)
        
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        url_entry = Gtk.Entry(placeholder_text="https://discord.com/app")
        name_entry = Gtk.Entry(placeholder_text="App Name (optional)")
        box.append(url_entry)
        box.append(name_entry)
        dialog.set_extra_child(box)
        
        def handle_response(d, r):
            d.close()
            if r == "next":
                url = url_entry.get_text()
                name = name_entry.get_text().replace(" ", "_")
                if not url:
                    self.show_message("Error", "URL is required to build a Live App.")
                    return
                self.select_live_app_icon(url, name)
                
        dialog.connect("response", handle_response)
        dialog.present()

    def select_live_app_icon(self, url, name):
        dialog = Gtk.FileDialog(title="Select Icon for Live App")
        f_filter = Gtk.FileFilter()
        f_filter.set_name("Images")
        f_filter.add_mime_type("image/png")
        f_filter.add_mime_type("image/jpeg")
        f_filter.add_mime_type("image/svg+xml")
        
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(f_filter)
        dialog.set_filters(filters)
        
        def on_icon_selected(d, result):
            try:
                file = d.open_finish(result)
                if file:
                    icon_path = file.get_path()
                    cmd = [self.get_script_path("muffin-make"), "live", url, icon_path]
                    if name:
                        cmd.append(name)
                    self.run_command_async(cmd, "Live App created successfully!")
            except GLib.Error:
                pass
                
        dialog.open(self, None, on_icon_selected)
            
    def on_make_folder_clicked(self, action, param):
        dialog = Gtk.FileDialog(title="Select Folder")
        dialog.select_folder(self, None, self.on_make_folder_dialog_open, None)
        
    def on_make_folder_dialog_open(self, dialog, result, data):
        try:
            folder = dialog.select_folder_finish(result)
            if folder:
                path = folder.get_path()
                name_dialog = Adw.MessageDialog(heading="App Name", transient_for=self)
                name_dialog.add_response("cancel", "Cancel")
                name_dialog.add_response("create", "Create")
                name_dialog.set_response_appearance("create", Adw.ResponseAppearance.SUGGESTED)
                
                name_entry = Gtk.Entry(placeholder_text="App Name (optional)")
                name_dialog.set_extra_child(name_entry)
                
                def handle_response(d, r):
                    d.close()
                    self.on_make_folder_response(r, path, name_entry.get_text())
                    
                name_dialog.connect("response", handle_response)
                name_dialog.present()
        except GLib.Error:
            pass

    def on_make_folder_response(self, response, path, name):
        if response == "create":
            cmd = [self.get_script_path("muffin-make"), "folder", path]
            if name:
                cmd.append(name.replace(" ", "_"))
            self.run_command_async(cmd, "App created successfully!")
            
    def run_command_async(self, cmd, success_msg):
        self.show_toast("Working...")
        
        def run():
            try:
                result = subprocess.run(cmd, capture_output=True, text=True)
                if result.returncode == 0:
                    GLib.idle_add(self.show_toast_and_reload, success_msg)
                else:
                    error_msg = result.stderr.strip() or result.stdout.strip() or "An error occurred."
                    GLib.idle_add(self.show_message, "Command Failed", error_msg)
            except Exception as e:
                GLib.idle_add(self.show_message, "Execution Error", f"Command: {' '.join(cmd)}\n\nError: {e}")
                
        threading.Thread(target=run, daemon=True).start()
        
    def show_toast_and_reload(self, message):
        self.show_toast(message)
        self.load_library()
        return False
        
    def show_toast(self, message):
        toast = Adw.Toast.new(message)
        self.toast_overlay.add_toast(toast)
        
    def show_message(self, title, message):
        dialog = Adw.MessageDialog(heading=title, transient_for=self)
        dialog.set_body(message)
        dialog.add_response("ok", "OK")
        dialog.connect("response", lambda d, r: d.close())
        dialog.present()
        return False


class MuffinApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.muffin.GUI", flags=Gio.ApplicationFlags.HANDLES_OPEN)
        
    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = MuffinGUI(self)
        win.present()
        
    def do_open(self, files, n_files, hint):
        win = self.props.active_window
        if not win:
            win = MuffinGUI(self)
        win.present()
        
        for file in files:
            path = file.get_path()
            if path and path.endswith(".mpa"):
                filename = os.path.basename(path)
                dest = os.path.join(win.library_path, filename)
                try:
                    shutil.copy2(path, dest)
                    win.show_toast(f"Imported {filename} to library!")
                    win.load_library()
                except Exception as e:
                    win.show_message("Error", f"Failed to import {filename}: {e}")

if __name__ == "__main__":
    app = MuffinApp()
    app.run(sys.argv)